# Copy to container/.env before running docker compose.
SEARCHONE_IMAGE=docker.io/foxtwobao/searchone
SEARCHONE_VERSION=latest
SEARCHONE_HOST=0.0.0.0
SEARCHONE_PORT=8888
SEARCHONE_PROXY_DIRECT_FALLBACK=1

# Optional first-start overrides. Empty values are generated automatically and
# persisted in the searchone-data volume.
SEARCHONE_MASTER_KEY=
SEARCHONE_SESSION_SECRET=
SEARCHONE_ADMIN_USERNAME=admin
SEARCHONE_ADMIN_PASSWORD=

# Provider credentials can also be configured later in /admin/providers.
TAVILY_API_KEY=
EXA_API_KEY=
METASO_API_KEY=
TIKHUB_TOKEN=
MINIMAX_API_KEY=
ZHIPU_CODING_PLAN_API_KEY=
